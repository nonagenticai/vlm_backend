SERVICE_NAME=vlm-backend
VERSION=0.1.0
ENVIRONMENT=production
LOG_LEVEL=INFO

# Platform tenant (licence registry name: platform-cp-1). Must be a UUID —
# an arbitrary string here MINTS a tenant that then owns real rows.
DEFAULT_TENANT_ID=0195f48b-d000-7000-8000-000000000001

VLM_MODEL=mlx-community/Qwen2-VL-7B-Instruct-4bit
VLM_MAX_TOKENS=1024
VLM_TEMPERATURE=0.2
VLM_BATCH_SIZE=1
VLM_IMAGE_MAX_PIXELS=2073600

CORS_ORIGINS=https://api.nonagentic.ai,https://w2v.nonagentic.ai
